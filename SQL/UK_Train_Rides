CREATE TABLE Dim_Journey(
Journey_ID           INT IDENTITY(1,1) PRIMARY KEY ,
Departure_Time       TIME NOT NULL ,
Arrival_Time         TIME NOT NULL ,
Actual_Arrival_Time  TIME ,
Journey_Status       NVARCHAR(20) NOT NULL ,
Reason_for_Delay     NVARCHAR(20) NOT NULL ,
)
INSERT INTO Dim_Journey (Departure_Time ,Arrival_Time,Actual_Arrival_Time, Journey_Status,Reason_for_Delay)
SELECT DISTINCT TRY_CONVERT(TIME , departure_time),
                TRY_CONVERT(TIME , arrival_time),
                TRY_CONVERT(TIME , NULLIF(actual_arrival_time , '')),
                journey_status , reason_for_delay
FROM staging_rides 

CREATE TABLE Fact_TrainRides (
Transaction_ID    NVARCHAR(50) NOT NULL PRIMARY KEY ,
Purchase_Date_ID  INT NOT NULL ,
Journey_Date_ID   INT NOT NULL ,
Purchase_ID       INT NOT NULL ,
Ticket_ID         INT NOT NULL ,
Route_ID          INT NOT NULL ,
Journey_ID        INT NOT NULL ,
Price             INT NOT NULL ,
Purchase_Time     TIME NULL ,
Refund_Request    TINYINT NOT NULL ,
CONSTRAINT FK_Fact_PurchaseDate FOREIGN KEY (Purchase_Date_ID) REFERENCES Dim_Purchase_Date(Purchase_Date_ID),
CONSTRAINT FK_Fact_JourneyDate FOREIGN KEY (Journey_Date_ID) REFERENCES Dim_Journey_Date(Journey_Date_ID),
CONSTRAINT FK_Fact_Purchase FOREIGN KEY (Purchase_ID) REFERENCES Dim_Purchase(PurchaseID),
CONSTRAINT FK_Fact_Ticket FOREIGN KEY (Ticket_ID) REFERENCES Dim_Ticket(Ticket_ID),
CONSTRAINT FK_Fact_Route FOREIGN KEY (Route_ID) REFERENCES Dim_Route(Route_ID),
CONSTRAINT FK_Fact_Journey FOREIGN KEY (Journey_ID) REFERENCES Dim_Journey(Journey_ID),
)
INSERT INTO Fact_TrainRides (Transaction_ID , Purchase_Date_ID ,Journey_Date_ID, Purchase_ID,
                              Ticket_ID ,Route_ID ,Journey_ID, Price,Purchase_Time, Refund_Request)
SELECT S.transaction_id , PD.Purchase_Date_ID , JD.Journey_Date_ID , P.PurchaseID , T.Ticket_ID , 
       R.Route_ID , J.Journey_ID , S.price , TRY_CONVERT(TIME , S.time_of_purchase),
       CASE WHEN S.refund_request = 'YES' THEN 1 ELSE 0 END 
FROM staging_rides S 
JOIN Dim_Purchase_Date PD ON PD.Full_Date = TRY_CONVERT(date , s.date_of_purchase,101)
JOIN Dim_Journey_Date  JD ON JD.Full_Date = TRY_CONVERT(date , s.date_of_journey ,101)
JOIN Dim_Purchase       P ON P.Purchase_Type = s.purchase_type AND P.Payment_Method = s.payment_method
JOIN Dim_Ticket         T ON T.Railcard = s.railcard AND T.Ticket_Class = S.ticket_class AND T.Ticket_Type = S.ticket_type
JOIN Dim_Route          R ON R.Departure_station = S.departure_station AND R.Arrival_Destination = S.arrival_destintion
JOIN Dim_Journey        J ON J.Departure_Time = TRY_CONVERT(TIME , S.departure_time) 
                         AND J.Arrival_Time = TRY_CONVERT(TIME , S.arrival_time) 
                         AND J.Journey_Status = S.journey_status 
                         AND J.Reason_for_Delay = S.reason_for_delay
                         AND (J.Actual_Arrival_Time = TRY_CONVERT(TIME , NULLIF(S.actual_arrival_time,''))
                         OR (J.Actual_Arrival_Time IS NULL AND NULLIF(S.actual_arrival_time , '') IS NULL)) 
