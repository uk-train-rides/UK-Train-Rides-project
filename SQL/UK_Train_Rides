--==================================
-- Journey Status Samary :
CREATE PROCEDURE SP_Journey_Status AS
BEGIN 
    SELECT J.Journey_Status , COUNT(FT.Transaction_ID) AS [Total Journeys] , SUM(FT.Price) AS [Total Revenue]
    FROM Fact_TrainRides FT JOIN Dim_Journey J ON FT.Journey_ID = J.Journey_ID
    GROUP BY J.Journey_Status 
END

-- Refund Requests by Journey Status :
CREATE PROCEDURE SP_Refund_by_Status AS 
BEGIN 
    SELECT J.Journey_Status , COUNT(FT.Transaction_ID) AS [Refund Count] , SUM(FT.Price) AS [Refund Amount]
    FROM Fact_TrainRides FT JOIN Dim_Journey J ON FT.Journey_ID = J.Journey_ID
    WHERE FT.Refund_Request = 'Yes'
    GROUP BY J.Journey_Status
END 

ALTER PROCEDURE SP_Refund_by_Status AS 
BEGIN 
    SELECT J.Journey_Status , COUNT(FT.Transaction_ID) AS [Refund Count] , SUM(FT.Price) AS [Refund Amount]
    FROM Fact_TrainRides FT JOIN Dim_Journey J ON FT.Journey_ID = J.Journey_ID
    WHERE FT.Refund_Request = 1
    GROUP BY J.Journey_Status
END 

EXEC SP_Journey_Status
EXEC SP_Refund_by_Status 

