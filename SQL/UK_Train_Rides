CREATE TABLE Dim_Purchase_Date (
Purchase_Date_ID    INT IDENTITY(1,1) PRIMARY KEY ,
Full_Date           DATE NOT NULL UNIQUE ,
[Day]               INT ,
[Month]             INT ,
[Year]              INT ,
[Quarter]           INT , 
)
-- DROP TABLE Dim_Purchase_Date

INSERT INTO Dim_Purchase_Date(Full_Date , [Day] , [Month] , [Year] , [Quarter])
SELECT DISTINCT PurchaseDate , DAY(PurchaseDate) , Month(PurchaseDate) , DATEPART(QUARTER , PurchaseDate), YEAR(PurchaseDate)
FROM(SELECT TRY_CONVERT(date , date_of_purchase , 101 ) AS PurchaseDate 
     FROM staging_rides )AS  PConvertDates 
ORDER BY PurchaseDate 

CREATE TABLE Dim_Journey_Date (
Journey_Date_ID INT IDENTITY(1,1) PRIMARY KEY ,
Full_Date       DATE NOT NULL UNIQUE,
[Day]           INT ,
[Month]         INT ,
[Year]          INT ,
[Quarter]       INT 
)

INSERT INTO Dim_Journey_Date(Full_Date , [Day] , [Month] , [Year] , [Quarter])
SELECT DISTINCT JourneyDate , DAY(JourneyDate) , Month(JourneyDate) , DATEPART(QUARTER , JourneyDate), YEAR(JourneyDate)
FROM(SELECT TRY_CONVERT(date , date_of_journey , 101 ) AS JourneyDate
     FROM staging_rides )AS  JConvertDates 
ORDER BY JourneyDate 

CREATE TABLE Dim_Purchase (
PurchaseID     INT IDENTITY(1,1) PRIMARY KEY ,
Purchase_Type  NVARCHAR(20) NOT NULL ,
Payment_Method NVARCHAR(30) NOT NULL ,
CONSTRAINT UQ_Dim_Purchase UNIQUE (Purchase_Type , Payment_Method)
)

INSERT INTO Dim_Purchase (Purchase_Type , Payment_Method )
