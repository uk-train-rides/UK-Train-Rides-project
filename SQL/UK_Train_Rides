--=================================
-- Views :
--=================================
-- Rides Full Details
CREATE VIEW VW_Rides_Full_Details AS 
SELECT FT.Transaction_ID , FT.Journey_Date_ID , R.Departure_station , R.Arrival_Destination , 
       T.Ticket_Class , T.Ticket_Type , P.Purchase_Type , J.Journey_Status , J.Reason_for_Delay,
       FT.Price , FT.Route_ID
FROM Fact_TrainRides FT 
JOIN Dim_Route R    ON FT.Route_ID = R.Route_ID
JOIN Dim_Ticket T   ON FT.Ticket_ID = T.Ticket_ID
JOIN Dim_Purchase P ON FT.Purchase_ID = P.PurchaseID
JOIN Dim_Journey  J  ON FT.Journey_ID = J.Journey_ID

-- Route Performance Summary
CREATE VIEW VW_Route_Performance AS 
SELECT R.Departure_station , R.Arrival_Destination , 
       COUNT(FT.Transaction_ID) AS[Total Journeys] , 
       SUM(CASE WHEN J.Journey_Status  = 'Delay' THEN 1 ELSE 0 END) AS [Delayed_Journeys],
       SUM(CASE WHEN FT.Refund_Request = 1 THEN 1 ELSE 0 END) AS [Refund_Requests]
FROM Fact_TrainRides FT 
JOIN Dim_Route R   ON FT.Route_ID = R.Route_ID
JOIN Dim_Journey J ON FT.Journey_ID = J.Journey_ID
GROUP BY R.Departure_station , R.Arrival_Destination

SELECT TOP 10 * 
FROM VW_Route_Performance
--===========================
-- Queries 
--===========================
-- Revenue By Ticket Class
SELECT COUNT(*) ,T.Ticket_Class , SUM(FT.Price) AS [Total Revenue] , AVG(FT.Price) AS [Average Price]
FROM Dim_Ticket T JOIN Fact_TrainRides FT ON T.Ticket_ID = FT.Ticket_ID
GROUP BY T.Ticket_Class
ORDER BY [Total Revenue] DESC 

-- Revenue By Ticket Type
SELECT COUNT(*) AS [Number Of Journey] , T.Ticket_Type , SUM(FT.Price) AS [Total Revenue] , AVG(FT.Price) AS [Average Price]
FROM Fact_TrainRides FT JOIN Dim_Ticket T ON FT.Ticket_ID = T.Ticket_ID 
GROUP BY T.Ticket_Type
ORDER BY [Total Revenue] DESC 

-- Top 10 Revenue-Generating Routes 
SELECT TOP 10 R.Departure_station , R.Arrival_Destination , COUNT(*) AS [Total Rides] ,
       SUM(FT.Price) AS [Total Revenue] , 
       SUM(FT.Price) *100.0 / SUM(SUM(FT.Price)) OVER() AS [Revenue PCT] 
FROM Fact_TrainRides FT JOIN Dim_Route R ON FT.Route_ID = R.Route_ID
GROUP BY R.Departure_station , R.Arrival_Destination
ORDER BY [Total Revenue] DESC 

-- Departure Stations Ranked by Revenue 
SELECT RANK() OVER (ORDER BY SUM(FT.Price) DESC) AS [Revenue Rank] ,
       COUNT(*) AS [Total Rides] , SUM(FT.Price) AS [Total Revenue] ,
       AVG(FT.Price) AS[Avg Revenue]
FROM Fact_TrainRides FT JOIN Dim_Route R ON FT.Route_ID = R.Route_ID
GROUP BY R.Departure_station 
ORDER BY [Revenue Rank]

-- Ticket Price Tiers 
SELECT [Price Tier] , COUNT(*) AS [Total Rides] ,SUM(Price) AS [Total Revenue] ,
       AVG(Price) AS [Avg Price] ,
       SUM(Price)*100.0 / SUM(SUM(Price)) OVER() AS [Revenue PCT]
FROM(
     SELECT Price , 
            CASE
               WHEN Price >= 50 THEN 'Premium' 
               WHEN Price >= 15 THEN 'Standard'
               ELSE 'Budget'
            END AS [Price Tier]
     FROM Fact_TrainRides
) AS Tiered
GROUP BY [Price Tier]
ORDER BY [Total Revenue] DESC;











